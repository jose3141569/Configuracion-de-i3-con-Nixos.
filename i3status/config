##############################################################################

general {
    interval 	= 1
    colors 	= true
    color_good      = '#88b090'
    color_degraded  = '#ccdc90'
    color_bad       = '#e89393'
}

order += "disk /"
order += "wireless wlp2s0"
order += "ethernet enp1s0"
order += "cpu_temperature 0"
order += "cpu_usage 0"
order += "load"
order += "tztime local"

wireless wlp2s0 {
    format_up = "%quality  🛜%essid "
    format_down = "desconectado"
}

ethernet enp1s0 {
    #if you use %speed, i3status requires root privileges
    format_up = "🔌(%speed)"
    format_down = "desconectado"
}


tztime local {
    format = "Num.Sem %V  🗓%e/%B/%A  ∑%H:%M:%S"
}

load {
    format = "📊%1min"
}

cpu_usage {
    format = "🖥%usage"
}

cpu_temperature 0 {
	format = "🌡 %degrees°C"
}

disk "/" {
	format = "💽%avail"
	prefix_type	= custom
	low_threshold = 20
	threshold_type = percentage_avail
}
